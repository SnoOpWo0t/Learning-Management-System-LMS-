{
    "kind": "collectionType",
    "collectionName": "course_ratings",
    "info": {
        "singularName": "course-rating",
        "pluralName": "course-ratings",
        "displayName": "Course Rating",
        "description": ""
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "rating": {
            "type": "integer",
            "min": 1,
            "max": 5,
            "required": true
        },
        "review": {
            "type": "text"
        },
        "course": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::course.course",
            "inversedBy": "course_ratings"
        },
        "student": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "plugin::users-permissions.user"
        }
    }
}
